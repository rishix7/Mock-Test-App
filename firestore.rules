rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Test content is intentionally public so unauthenticated creators can publish.
    match /tests/{testId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['name', 'description', 'questions', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.questions is list
        && request.resource.data.questions.size() > 0;
      allow update, delete: if false;

      // Small, compressed diagrams are separate documents so loading the test
      // list does not download every image. They are created atomically with
      // their parent test and are immutable after publishing.
      match /diagrams/{diagramId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['dataUrl', 'contentType', 'byteSize'])
          && request.resource.data.dataUrl is string
          && request.resource.data.dataUrl.size() <= 900000
          && request.resource.data.contentType in ['image/webp', 'image/jpeg', 'image/png']
          && request.resource.data.byteSize is int
          && request.resource.data.byteSize > 0
          && request.resource.data.byteSize <= 614400
          && getAfter(/databases/$(database)/documents/tests/$(testId)).data.published == true;
        allow update, delete: if false;
      }
    }

    // Attempts can only be created/read by their signed-in owner. Aggregates are
    // written by the trusted Cloud Function, never by clients.
    match /attempts/{attemptId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.testId is string
        && request.resource.data.answers is list;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /testStats/{testId} {
      allow read: if true;
      allow write: if false;
    }

    match /processedAttempts/{attemptId} {
      allow read, write: if false;
    }
  }
}
